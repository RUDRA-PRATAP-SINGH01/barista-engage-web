# Production builds: full API origin (also set in render.yaml on Render).
VITE_API_BASE_URL=https://barista-engage-api-8okw.onrender.com

# Local `npm run dev` always uses Vite `/api` proxy (src/lib/env.ts + vite.config.ts),
# regardless of this value, to avoid CORS on localhost.

# Set to false to hide Campaign Visual generation (use if Gemini image quota is exhausted).
# VITE_ENABLE_CAMPAIGN_CREATIVE=false
